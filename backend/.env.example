# Copy to backend/.env and fill in. NEVER commit the real .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Shared secrets between the Next.js proxy (Vercel) and this API.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=change-me
BACKEND_ADMIN_KEY=change-me-too
# JSON list of allowed browser origins (the proxy is server-side, so this is mostly for local dev)
CORS_ORIGINS=["http://localhost:3000"]

# --- Supabase ---
# Use the Supavisor *session mode* pooler string (Project Settings -> Database -> Connection string -> Session pooler).
# The direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_BUCKET=documents

# --- Local embedding model (CPU, ONNX via fastembed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=16
EMBEDDING_THREADS=2
EMBEDDING_CACHE_DIR=.cache/fastembed

# --- Groq ---
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low

# --- Retrieval / limits ---
MIN_RELEVANCE=0.45
RETRIEVAL_TOP_K=6
MAX_UPLOAD_MB=25
MAX_PAGES=500
CHAT_RATE_LIMIT=10/minute;200/day

# --- Deployment (docker compose) ---
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> install token
CLOUDFLARE_TUNNEL_TOKEN=
