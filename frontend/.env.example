# Copy to frontend/.env.local for local dev; set the same variables in Vercel → Project → Settings → Environment Variables.
# All of these are SERVER-ONLY (no NEXT_PUBLIC_ prefix) — they are never sent to the browser.

# Where the FastAPI backend lives (Cloudflare Tunnel hostname in production)
BACKEND_URL=http://localhost:8000
# Must match BACKEND_API_KEY / BACKEND_ADMIN_KEY in backend/.env
BACKEND_API_KEY=change-me
BACKEND_ADMIN_KEY=change-me-too

# Admin login for uploading/deleting documents
ADMIN_PASSWORD=choose-a-strong-password
# Random string, 32+ chars:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
